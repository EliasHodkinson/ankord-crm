# ── Ankor'd CRM · environment template ───────────────────────────────
# Copy to .env.local and fill in. Vercel gets the same values via project settings.

# Neon — use the POOLED connection string (host contains "-pooler")
DATABASE_URL=

# Microsoft Entra ID app registration (single tenant)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Encrypts the Microsoft tokens held for each session. Already generated.
APP_ENCRYPTION_KEY=            # openssl rand -base64 32

# Where this deployment is reachable — no trailing slash.
APP_URL=http://localhost:3000

# Optional — Power Automate Workflows webhook for Teams notifications.
# Unset means notifications are silently off. See teams/README.md
TEAMS_WEBHOOK_URL=

# Optional — Xero integration. Create the app at developer.xero.com and set the
# redirect URI to <APP_URL>/api/xero/callback. Unset means Xero is switched off.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
