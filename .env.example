# ── Ankor'd CRM · environment template ───────────────────────────────
# Copy to .env.local and fill in. Vercel gets the same values via project settings.

# Neon — use the POOLED connection string (host contains "-pooler")
DATABASE_URL=

# Microsoft Entra ID app registration (single tenant)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Encrypts the Microsoft tokens held for each session. Already generated.
APP_ENCRYPTION_KEY=            # openssl rand -base64 32

# Where this deployment is reachable — no trailing slash.
APP_URL=http://localhost:3000
